{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "XMD",
  "version": "1.0.0",
  "identifier": "x.media.downloader",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "X 媒体下载器",
        "width": 820,
        "height": 940,
        "minWidth": 780,
        "minHeight": 800,
        "resizable": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
